# Production API base URL. The API server must allow CORS from the domain you deploy this app on.
# If it does not, put a reverse proxy in front (see README) and point this at the proxy path.
VITE_API_BASE=https://xnrrpsi8wu.ap-south-1.awsapprunner.com

# Dev only: where the Vite dev server proxies /api requests.
VITE_API_PROXY_TARGET=https://xnrrpsi8wu.ap-south-1.awsapprunner.com

# Optional: store geofence radius (metres) for auto check-in, used only when store coordinates are known.
VITE_GEOFENCE_METERS=100
